# --- credentials -------------------------------------------------------------
# Service-account JSON grants real project access. Unanchored, so it matches at
# any depth: firebase-service-account.json, backend/firebase-service-account.json, ...
*service-account*.json

# --- environment files ---------------------------------------------------------
# Real environment files hold live credentials (Stripe keys, DB passwords, API
# tokens) and must NEVER be committed. These patterns contain no slash, so git
# applies them at EVERY depth — .env, backend/.env, mobile/.env, .env.production,
# .env.local and anything else beginning with `.env.` are all covered.
.env
.env.*

# Only the templates are exempt. They carry variable names, defaults and
# comments — never a real value. Without these negations the `.env.*` rule above
# silently swallows them and nobody else can bring the stack up.
!.env.example
!.env.docker.example

# React Native's versioned Xcode shim (mobile/ios/.xcode.env) holds a NODE_BINARY
# path and no secrets, so it stays tracked — the rules above never match it. Its
# developer-specific counterpart must not be committed.
.xcode.env.local

# --- local Python environment --------------------------------------------------
# A virtualenv is machine-specific: absolute interpreter paths, compiled wheels
# built for one OS and CPU. It is recreated from requirements.txt, never shared.
.venv/
venv/

# --- Python bytecode -----------------------------------------------------------
# Bytecode is a build artifact, and it is version-stamped: a 3.11 interpreter
# writes `*.cpython-311.pyc` next to a committed `*.cpython-313.pyc` rather than
# replacing it, so every developer on a different minor version adds a second
# full set of files that no one reviews.
#
# 283 `*.cpython-313.pyc` files were committed before this rule existed, and
# ignoring a path does not untrack what is already tracked. They were removed
# from the index on 2026-10-04 with `git rm -r --cached`, which leaves every
# file on disk and only stops git following them. They churned on every run, so
# the working tree was never clean and a real change had to be picked out of
# three hundred regenerated ones.
__pycache__/
*.pyc

# --- Celery beat state ---------------------------------------------------------
# `celerybeat-schedule.{bak,dat,dir}` is a shelve of when each periodic task
# last ran. Beat rewrites it on every start, so it is runtime state and not
# configuration - there is nothing in it another machine could use, and the
# three files were committed by accident in the V2 merge. Untracked on
# 2026-10-04 for the same reason as the bytecode above.
backend/celerybeat-schedule*

# --- local scratch -------------------------------------------------------------
# Git bundles and suite logs produced while working here. Large, regenerable,
# and meaningful only on the machine that made them.
*.bundle
backend/.suite.log

# --- agent scratch -------------------------------------------------------------
# Per-plan working directory for subagent-driven execution: ledger, task briefs,
# implementer reports, review packages. Recoverable from git history and of no
# use to anyone else, so it is never committed.
.superpowers/

# --- local worktrees -------------------------------------------------------------
# Isolated checkouts used while executing a plan (see
# superpowers:using-git-worktrees). Each is a full working copy of tracked
# branches already in git history, so committing them would duplicate the repo.
.worktrees/
backend/*_tmp.py

# Worker logs, written by --logfile on the dev box.
backend/logs/
