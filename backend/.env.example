APP_NAME=Restaurant RAG API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_rag
DATABASE_ECHO=false

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_OFFER_TIMEOUT_SECONDS=30
QWEN_OFFER_MODEL_NAME=qwen3:8b

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=259200
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
GENERATED_COMBO_MIN_UNIQUE_USERS=1
GENERATED_COMBO_MIN_VISIBLE_UNIQUE_USERS=3
GENERATED_COMBO_EXPIRY_DAYS=90
GENERATED_COMBO_DRAFT_EXPIRY_DAYS=30
GENERATED_COMBO_COUNTED_STATUSES=DELIVERED
GENERATED_COMBO_COUNTED_PAYMENT_STATUSES=PAID,COD

ENABLE_AI_OFFER_GENERATION=false
ENABLE_AI_RECOMMENDATION_RERANKING=false
AI_OFFER_CRON_ENABLED=false
AI_OFFER_BATCH_SIZE=50
AI_OFFER_USER_LIMIT=0
AI_MAX_FLAT_DISCOUNT=100
AI_MAX_PERCENTAGE_DISCOUNT=30
AI_MIN_ORDER_THRESHOLD=99
AI_OFFER_VALIDITY_DAYS=7
AI_OFFER_CRON_HOUR=17
AI_OFFER_CRON_MINUTE=0
AI_RECOMMENDATION_CANDIDATE_LIMIT=50
AI_RECOMMENDATION_FINAL_LIMIT=20
AI_RECOMMENDATION_MIN_CANDIDATE_COUNT=10
AI_RECOMMENDATION_RETRY_COOLDOWN_MINUTES=15
AI_RECOMMENDATION_MAX_SAME_RESTAURANT=3
AI_RECOMMENDATION_MAX_SAME_CUISINE=4
AI_RECOMMENDATION_MAX_SAME_CATEGORY=4

# --- Payments (Stripe) ------------------------------------------------------
# Placeholders only. Put real keys in .env, which is gitignored.
#
# Card payments stay switched off until both keys are real: any value ending in
# "_mock" makes `settings.stripe_is_configured` false, GET /payments/config
# reports CARD as unavailable, and the app offers COD only.
#
# Server-side secret. Never put this in the mobile app or any client bundle.
STRIPE_SECRET_KEY=sk_test_mock
# Not secret, but the app fetches it at runtime via GET /payments/config rather
# than hardcoding it, so rotating the key needs no app release.
STRIPE_PUBLISHABLE_KEY=pk_test_mock
# Webhook signing secret — this is what proves a webhook really came from
# Stripe. Card payments can never be confirmed while it is empty.
#   stripe listen --forward-to localhost:8000/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_mock
# Currency the order total is charged in; also stamped onto every order.
PAYMENT_CURRENCY=inr
# Minutes an unpaid card order survives before the reaper cancels it.
PAYMENT_INTENT_TTL_MINUTES=30
# Razorpay is not implemented; these remain only so old config does not break.
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=razorpay_mock_secret

FCM_PROJECT_ID=restaurant-rag
FCM_CREDENTIALS_PATH=firebase-service-account.json
