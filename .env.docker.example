# ===========================================================================
# Compose configuration template.
#
#   cp .env.docker.example .env
#
# `.env` at the repository root is what `docker compose` reads for ${VAR}
# substitution. It is already gitignored (the repo's .gitignore covers .env and
# .env.*), so real values never reach version control.
#
# NOTHING IN THIS FILE IS A REAL SECRET. Variables marked REQUIRED have no
# default and compose will refuse to start without them — that is deliberate,
# so a deployment fails loudly at start-up rather than silently running with a
# publicly-known key.
# ===========================================================================

# --- required secrets --------------------------------------------------------

# REQUIRED. Signs every access token. Anyone holding it can mint a token for any
# user, including an admin. Generate a fresh one per environment — never reuse
# the staging value in production:
#   openssl rand -hex 32
JWT_SECRET_KEY=

# REQUIRED. Postgres superuser password for the container.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# --- database ----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=restaurant_rag
DATABASE_ECHO=false

# Connection pool, PER PROCESS. Total demand is
#   (GUNICORN_WORKERS + sum of CELERY_*_CONCURRENCY) x (POOL_SIZE + MAX_OVERFLOW)
# At the defaults: (4 + 9) x 10 = 130, plus beat and migrate, against
# POSTGRES_MAX_CONNECTIONS below. Raise the worker counts and redo this sum, or
# Postgres starts refusing connections under load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
# Stock Postgres allows 100, which the arithmetic above can exceed.
POSTGRES_MAX_CONNECTIONS=200

# --- application -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Log timestamps. Keep aligned with BUSINESS_TIMEZONE below — compose cannot
# nest one variable default inside another, so they are set independently.
TZ=Asia/Kolkata
APP_NAME=Restaurant RAG API
APP_VERSION=1.0.0
API_V1_PREFIX=/api
BUSINESS_TIMEZONE=Asia/Kolkata

# Exact scheme+host+port of every browser origin that calls the API.
# In the dev topology the SPAs are served same-origin through nginx, so CORS is
# not exercised at all and these are only a fallback for direct :8000 access.
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8081,http://localhost:5173,http://localhost:5174

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ollama / models ---------------------------------------------------------
# Defaults to the in-network container. Point it elsewhere to use a dedicated
# GPU host, or the macOS host's native Ollama (Docker cannot pass a GPU into a
# container on macOS, so the container is CPU-only there):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- embeddings --------------------------------------------------------------
# ollama = local dev (nomic-embed-text). gemini = production (Gemini Embedding 2).
# Set independently of generation.
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768
# Only needed when EMBEDDING_PROVIDER=gemini. Backend-only secret.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_SECONDS=20

# --- Ollama Cloud ------------------------------------------------------------
# Bearer token for https://ollama.com. Leave EMPTY for a local Ollama.
# SECRET: backend-only. Never a build arg, never in a browser or mobile bundle.
OLLAMA_API_KEY=
#
# Where EMBEDDINGS go when that is not the generation host. Empty = same host.
#
# MEASURED 20 Aug 2026 against the live API: Ollama Cloud serves NO embedding
# route. /api/embed answers 401 for every model with or without a key, and both
# /api/embeddings and /v1/embeddings answer 404, while /api/generate with the
# same key answers 200. So a cloud-generation deployment MUST keep a local
# Ollama for menu embeddings and RAG retrieval and point this at it:
#
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=<your key>
#   OLLAMA_EMBEDDING_BASE_URL=http://ollama:11434
#
# WARNING — before switching generation to Cloud, read the model note below.
OLLAMA_EMBEDDING_BASE_URL=

# Hidden-reasoning level for the generation model: false | low | medium | high.
# "false" for qwen3:8b. "low" for gpt-oss, which ignores think:false and would
# otherwise spend its whole token budget reasoning and return an empty response.
# medium/high are measured NOT to fit this app's budgets.
OLLAMA_THINK_MODE=false
#
# Cloud model availability, measured against the live API on this account:
#   qwen3.5:cloud / qwen3.5:397b  -> HTTP 403, "requires a subscription"
#   gpt-oss:20b / gpt-oss:120b    -> HTTP 200, accessible
#
# gpt-oss is NOT a drop-in replacement for qwen3:8b on these paths. It ignores
# `think: false` and its reasoning tokens consume `num_predict`, so at the
# budgets this app is tuned for the response field comes back EMPTY and every
# path silently falls back to its deterministic template. Measured:
#   planner  (90 tokens)  0/3 usable
#   narrator (220 tokens) 0/2 usable
#   answer   (120 tokens) 0/4 usable; 1/4 at 600; 4/5 at 2000 (16x the budget),
#                         and 2 of those 4 broke the prompt's causality rule.
# The fix is OLLAMA_THINK_MODE below, NOT a bigger budget.
#
# --- switching local <-> cloud (env only; no code change) --------------------
#
# LOCAL DEVELOPMENT (default above): local Ollama, qwen3:8b, no key.
#   OLLAMA_BASE_URL=http://ollama:11434
#   OLLAMA_THINK_MODE=false
#
# PRODUCTION on Ollama Cloud — set ALL of these together:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=<your key>
#   OLLAMA_THINK_MODE=low
#   OLLAMA_EMBEDDING_BASE_URL=http://ollama:11434   # embeddings stay local
#   OLLAMA_CHAT_MODEL=gpt-oss:20b
#   AI_MANAGER_CHAT_ANSWER_MODEL=gpt-oss:20b
#   CHAT_TOOL_PLANNER_MODEL=gpt-oss:20b
#   AI_MANAGER_NARRATION_MODEL=gpt-oss:20b
#   ANALYST_MODEL=gpt-oss:20b
#   QWEN_OFFER_MODEL_NAME=gpt-oss:20b
#   AI_MANAGER_CHAT_ANSWER_MAX_TOKENS=300           # 120 truncates gpt-oss JSON
#   OLLAMA_EMBEDDING_MODEL=nomic-embed-text         # unchanged in both setups
AI_MANAGER_CHAT_ANSWER_MODEL=qwen3:8b
CHAT_TOOL_PLANNER_MODEL=qwen3:8b
AI_MANAGER_NARRATION_MODEL=qwen3:8b
ANALYST_MODEL=qwen3:8b
QWEN_OFFER_MODEL_NAME=qwen3:8b

# --- Ollama server tuning ----------------------------------------------------
# How many generations Ollama serves at once. 1 is the measured current
# behaviour and the reason one owner's question blocks every other restaurant's.
# Raise only after the model host has real memory headroom — each parallel slot
# costs KV-cache memory.
OLLAMA_NUM_PARALLEL=1
# 1 deliberately: two resident models were 8.1GB of weights on a 16GB machine
# and a direct cause of the measured swap thrash.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=60m
# Matches the num_ctx the chat answer call pins; larger allocates KV cache the
# request can never use.
OLLAMA_CONTEXT_LENGTH=4096

# --- AI Manager feature flags ------------------------------------------------
ENABLE_AI_MANAGER_INSIGHTS=false
ENABLE_AI_MANAGER_CHAT_TOOLS=true
ENABLE_AI_MANAGER_CHAT_ANSWERS=true
ENABLE_AI_MANAGER_ACTIONS=false
AI_MANAGER_CRON_ENABLED=false
ENABLE_AI_MANAGER_NARRATION=false
ENABLE_AI_MANAGER_CHAT_LLM_ROUTER=true
# The anchor of the timeout chain:
#   AI_MANAGER_CHAT_ANSWER_TIMEOUT_SECONDS < GUNICORN_TIMEOUT <= proxy_read_timeout
# Drop either of the outer two below this and the worker is killed or the
# connection cut mid-answer, so the owner sees a network error instead of the
# deterministic fallback the app was about to send.
AI_MANAGER_CHAT_ANSWER_TIMEOUT_SECONDS=110
# The single biggest latency lever on a CPU-only host.
AI_MANAGER_CHAT_ANSWER_MAX_TOKENS=120

# --- Redis -------------------------------------------------------------------
# Three databases on one server: /0 cache, /1 results, /2 broker. The split is
# set by compose, not here. noeviction protects queued work: under an LRU policy
# Redis would silently drop pending tasks to make room for cache entries.
REDIS_CACHE_TTL_SECONDS=259200
REDIS_MAXMEMORY_POLICY=noeviction

# --- Celery ------------------------------------------------------------------
CELERY_LOG_LEVEL=info
CELERY_DEFAULT_CONCURRENCY=2
# 1 on purpose: Ollama serves one generation at a time (-np 1), so extra
# analytics workers queue against each other while holding DB connections.
CELERY_ANALYTICS_CONCURRENCY=1
CELERY_EMBEDDINGS_CONCURRENCY=2
CELERY_NOTIFICATIONS_CONCURRENCY=4
# Task time limits. Without them a hung job holds its slot forever — and with
# analytics at concurrency 1 that stops the nightly analysis entirely.
# soft = raises an exception inside the task; hard = kills the child process.
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
# Analytics gets far longer on purpose: generate_owner_briefings_task iterates
# up to 100 restaurants in ONE task, each of which may call the model. A short
# limit here would kill legitimate nightly runs.
CELERY_ANALYTICS_SOFT_TIME_LIMIT=3600
CELERY_ANALYTICS_TIME_LIMIT=3900

# --- Gunicorn (production API) ----------------------------------------------
GUNICORN_WORKERS=4
# Must exceed AI_MANAGER_CHAT_ANSWER_TIMEOUT_SECONDS (110s default) or gunicorn
# kills the worker mid-answer.
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
# Which peers may set X-Forwarded-*. gunicorn's default of 127.0.0.1 makes it
# ignore nginx entirely, because nginx connects from a Docker bridge address —
# the app then believes every request arrived over plain HTTP. Safe as `*` here
# because the API publishes no port in production; nginx is the only route in.
FORWARDED_ALLOW_IPS=*

# --- payments ----------------------------------------------------------------
# Any value ending in _mock keeps card payments switched off and the app offers
# cash on delivery only (settings.stripe_is_configured).
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock
# Without this, every webhook is rejected and no card payment can be confirmed.
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=inr
STRIPE_API_VERSION=2024-11-20.acacia
PAYMENT_INTENT_TTL_MINUTES=30

# --- Firebase ----------------------------------------------------------------
FCM_PROJECT_ID=
# Host path to the service-account JSON, mounted as a Docker secret at
# /run/secrets/. Never baked into an image.
FIREBASE_CREDENTIALS_FILE=./backend/firebase-service-account.json

# --- frontend build args -----------------------------------------------------
# Build-time only — Vite inlines these, so changing one needs a rebuild:
#   docker compose build frontend-admin
# Dev: /api works because nginx serves the API same-origin.
# Prod: set to the full API URL, e.g. https://api.example.com/api
ADMIN_API_BASE_URL=/api
CUSTOMER_API_BASE_URL=/api

# --- dev host port bindings (all on 127.0.0.1) -------------------------------
HTTP_HOST_PORT=80
ADMIN_HOST_PORT=8081
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
OLLAMA_HOST_PORT=11434

# --- production only ---------------------------------------------------------
# Required by docker-compose.prod.yml; leave blank for development.
API_DOMAIN=
ADMIN_DOMAIN=
APP_DOMAIN=
# Used only by the hand-run certbot command; no compose service reads it.
ACME_EMAIL=
# REQUIRED in production. `local` is a mutable tag — it cannot be pulled
# meaningfully and there is nothing to roll back to. Use a git SHA or a release
# version:  IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=local
API_MEM_LIMIT=2g
OLLAMA_MEM_LIMIT=10g
OLLAMA_MEM_RESERVATION=8g
