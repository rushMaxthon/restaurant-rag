# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Create a key once with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore -alias release \n#     -keyalg RSA -keysize 2048 -validity 10000
# Keep release.keystore and these passwords somewhere safe: losing them means you
# can no longer publish updates to the same app listing.
storeFile=../release.keystore
storePassword=change-me
keyAlias=release
keyPassword=change-me
