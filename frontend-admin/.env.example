# Admin SPA build-time configuration.
#
# NOTHING HERE IS REQUIRED. src/config/api.ts already picks the right backend
# from the build mode: `npm run dev` uses http://localhost:8000/api and
# `npm run build` uses the Render service. Local development and Vercel
# production both work with no env var set at all.
#
# Set this only to point a build somewhere else — a staging backend, or a LAN
# address so a phone on the same network can reach your dev server.
#
# Vite inlines VITE_* at BUILD time, so a change needs a rebuild (on Vercel, a
# redeploy). Only variables prefixed VITE_ are exposed to client code, and
# everything exposed to client code is public — never put a secret here.
#
# Must include the /api suffix: the backend mounts every route under it.
#
#   cp .env.example .env.local
#
# VITE_API_BASE_URL=http://192.168.1.50:8000/api
