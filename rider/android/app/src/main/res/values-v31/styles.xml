<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws every app's splash itself: the mark, white on the
         brand orange, instead of the launcher icon on a white screen. -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
    </style>
</resources>
