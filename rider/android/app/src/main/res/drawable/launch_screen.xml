<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: brand orange with the mark in the
     middle, so the first frame already looks like the app's own splash
     (SplashOverlay picks up from here). Android 12+ draws its own from
     values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:drawable="@color/brand" />
  <item
      android:width="288dp"
      android:height="288dp"
      android:drawable="@drawable/splash_mark"
      android:gravity="center" />
</layer-list>
