# Production edge configuration — TEMPLATE.
#
# This file is a `.conf.template`, not a `.conf`, so nginx does NOT load it as
# written: it is rendered by nginx's own envsubst entrypoint (the official image
# processes /etc/nginx/templates/*.template into /etc/nginx/conf.d/ at start-up)
# using API_DOMAIN, ADMIN_DOMAIN and APP_DOMAIN from the environment. Compose
# mounts it into /etc/nginx/templates for that reason.
#
# It is deliberately NOT applied by this audit's work: obtaining certificates
# and pointing DNS are production deployment actions, and the brief excludes
# running those. What follows is the configuration those steps will need.
#
# Before first start the certificates must exist, or nginx will refuse to load
# the ssl_certificate lines and the container will crash-loop. See the ACME
# bootstrap note at the bottom.

upstream api_upstream {
    server api:8000;
    keepalive 32;
}

# --- HTTP: ACME challenge, then redirect everything to HTTPS ----------------
server {
    listen 80;
    server_name ${API_DOMAIN} ${ADMIN_DOMAIN} ${APP_DOMAIN};

    # Must stay reachable over plain HTTP for certificate renewal.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- API --------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    include /etc/nginx/snippets/api-proxy.conf;

    # The API is served under /api by the application's own prefix, so anything
    # else on this host is not a route.
    location / {
        return 404;
    }
}

# --- Admin panel ------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    # The admin bundle is built with VITE_API_BASE_URL pointing at the API
    # domain, so it makes cross-origin requests and BACKEND_CORS_ORIGINS must
    # list https://${ADMIN_DOMAIN} exactly.
    #
    # Alternatively, build it with VITE_API_BASE_URL=/api and uncomment the
    # include below to serve the API same-origin — which removes CORS from the
    # picture entirely. Pick one; do not do both halves of different ones.
    # include /etc/nginx/snippets/api-proxy.conf;

    location / {
        proxy_pass http://frontend-admin:80;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

# --- Customer web app -------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    # include /etc/nginx/snippets/api-proxy.conf;   # see note above

    location / {
        proxy_pass http://frontend-customer:80;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

# --- ACME bootstrap ----------------------------------------------------------
#
# Chicken-and-egg: nginx will not start without certificates, and certbot's
# webroot challenge needs nginx running. The standard resolution, to be run at
# deploy time and NOT by this audit:
#
#   1. comment out the three 443 server blocks
#   2. docker compose up -d nginx
#   3. docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
#        -d ${API_DOMAIN} -d ${ADMIN_DOMAIN} -d ${APP_DOMAIN} \
#        --email "$ACME_EMAIL" --agree-tos --no-eff-email
#   4. restore the 443 blocks, docker compose exec nginx nginx -s reload
